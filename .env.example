# ==============================================================================
# OpsSaathi AI - Environment Configuration (.env.example)
# Team Two Bits | Paytm Build for India AI Hackathon (Track 3: Autonomous AI Teammates)
# Copy this file to .env and fill in your private API keys.
# NEVER commit the real .env to git.
# ==============================================================================

# Application Environment
APP_ENV="development"
FRONTEND_ORIGIN="http://localhost:5173"
JWT_SECRET="generate-a-secure-random-secret-key-32-chars-minimum"

# Database Configuration
# Default PostgreSQL URL (via Docker Compose):
DATABASE_URL="postgresql+psycopg://user:password@localhost:5432/opssaathi"
# Read-only verifier role (for independent verification service):
VERIFIER_DATABASE_URL="postgresql+psycopg://verifier_ro:password@localhost:5432/opssaathi"

# Offline / Zero-Docker SQLite Fallback (Optional):
# DATABASE_URL="sqlite+aiosqlite:///./opssaathi.db"
# VERIFIER_DATABASE_URL="sqlite+aiosqlite:///./opssaathi.db"

# LLM Providers
# Options: "gemini" | "sarvam" | "mock"
LLM_PROVIDER="gemini"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
SARVAM_API_KEY="YOUR_SARVAM_API_KEY"

# Paytm Integration (Legacy Public Test Credentials / Staging)
PAYTM_ENVIRONMENT="staging"
PAYTM_MID="YOUR_TEST_MID"
PAYTM_MERCHANT_KEY="YOUR_TEST_MERCHANT_KEY"
PAYTM_WEBSITE_NAME="WEBSTAGING"

# Voice & Multilingual Settings
# VOICE_PROVIDER options: "sarvam" | "browser" | "twilio" (browser is automatic fallback)
VOICE_PROVIDER="sarvam"
DEFAULT_LANGUAGE="en"          # Options: "en" | "hi" | "mr"

# Operational Policies & Thresholds
DEMO_DATA_MODE="true"
DEMO_DETERMINISTIC="false"     # true = temperature 0, response cache, replay mode
RESYNC_APPROVAL_THRESHOLD_INR="5000"
SETTLEMENT_OPS_ADAPTER="mock"
